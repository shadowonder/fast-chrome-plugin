{
  "name": "base-extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:build": "node --test tests/build.test.mjs",
    "format": "prettier --config .prettierrc.json --write . ../README.md",
    "format:check": "prettier --config .prettierrc.json --check . ../README.md",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run verify:build && npm run format:check"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "3.0.0",
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
